*.env
!*.env.example
# merged runtime env (devnet-env + real Sepolia role private keys)
*-runtime-env
sepolia-runtime-env
jwt.hex
*.jwt
keystore/
keys/
secrets/

# Node data / sync state (lives on the server, not in the repo)
data/
*.log
